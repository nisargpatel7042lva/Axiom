
action "spectra_vault_deposit_event" "svm::deploy_subgraph" {
    program_id = action.deploy_spectra_vault.program_id
    program_idl = action.deploy_spectra_vault.program_idl
    block_height = 0 // action.deploy_spectra_vault.block_height
    event {
        name = "DepositEvent"
    }
}

