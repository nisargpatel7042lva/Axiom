# Solana RPC
SOLANA_RPC_URL=https://api.devnet.solana.com

# Vault authority keypair (JSON array of secret key bytes)
VAULT_AUTHORITY_KEYPAIR_PATH=./keypair.json

# Jupiter Prediction API key (get from portal.jup.ag)
JUPITER_PREDICTION_API_KEY=your-key-from-portal.jup.ag

# Deployed Anchor program ID
VAULT_PROGRAM_ID=your-deployed-program-id

# USDC mint (devnet test token)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Vault IDs (must match on-chain initialize_vault calls)
SAFE_VAULT_ID=1
CONTRARIAN_VAULT_ID=2
YIELD_VAULT_ID=3

# Health check port
HEALTH_PORT=3001

# Logging (debug | info | warn | error)
LOG_LEVEL=info
