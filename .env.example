# ═══════════════════════════════════════════════════════════════════
# Spectra Vaults — Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# SECURITY
# - Copy this file to `.env.local` (repo root) and `engine/.env` (engine).
# - Never commit real keys. Anything `NEXT_PUBLIC_*` is exposed in the browser.
# - See SECURITY-SECRETS.md in the repo root.
#
# ═══════════════════════════════════════════════════════════════════

# Solana cluster: devnet | testnet | mainnet-beta (default devnet)
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Solana RPC — must match the cluster above (public devnet RPC if unset)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: custom USDC / test USDC mint (required if your testnet mint differs)
# NEXT_PUBLIC_USDC_MINT=

# Vault authority keypair (file must NOT be committed — keep outside repo or gitignored name)
WALLET_KEYPAIR_PATH=~/.config/solana/id.json
VAULT_AUTHORITY_KEYPAIR_PATH=./keypair.json

# USDC mint (devnet test token)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Deployed Anchor program ID
VAULT_PROGRAM_ID=JBagp4qXz26XMHce1tXMpEwgVKPBpRGj7ejvsJXaoQhH

# ── Jupiter Developer Platform (Bounty 1) ────────────────────────
# Single API key from developers.jup.ag for ALL Jupiter APIs
# (Prediction, Price, Tokens, Trigger, Lend)
# Server-only when possible (not bundled to the browser)
JUPITER_API_KEY=your-key-from-developers.jup.ag
# Optional safety switch for limit-order path (Trigger API).
# Recommended false when Trigger API error rate is elevated.
# JUPITER_TRIGGER_ENABLED=false
# Optional: only if you accept the key being visible in every user's browser (dev/demo)
NEXT_PUBLIC_JUPITER_API_KEY=

# ── Dune SIM (Bounty 2) ─────────────────────────────────────────
# API key from sim.dune.com — prefer server-only; avoid NEXT_PUBLIC in production
DUNE_SIM_API_KEY=your-key-from-sim.dune.com
NEXT_PUBLIC_DUNE_SIM_API_KEY=

# ── RPC Fast (Bounty 3) ─────────────────────────────────────────
# Optional: Yellowstone gRPC endpoint for real-time streaming
RPC_FAST_GRPC_URL=your-grpc-endpoint

# ── PostHog Analytics (tester telemetry) ─────────────────────────────────────
# Project API key from PostHog project settings (safe for client-side use).
NEXT_PUBLIC_POSTHOG_KEY=
# Alias used in some dashboards/setups; either key works in this app.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Optional explicit toggle. Defaults to enabled in production and disabled in development.
# NEXT_PUBLIC_POSTHOG_ENABLED=true
# Optional region host (US default below). Example EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional same-origin proxy path (e.g. /ingest). Leave empty to send directly to NEXT_PUBLIC_POSTHOG_HOST.
# NEXT_PUBLIC_POSTHOG_PROXY_PATH=/ingest
