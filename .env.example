# ═══════════════════════════════════════════════════════════════════
# Spectra Vaults — Environment Variables
# ═══════════════════════════════════════════════════════════════════

# Solana RPC — use RPC Fast for low-latency infrastructure (Bounty 3)
NEXT_PUBLIC_SOLANA_RPC_URL=https://your-endpoint.rpcfast.com
SOLANA_RPC_URL=https://your-endpoint.rpcfast.com

# Vault authority keypair
WALLET_KEYPAIR_PATH=~/.config/solana/id.json
VAULT_AUTHORITY_KEYPAIR_PATH=./keypair.json

# USDC mint (devnet test token)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Deployed Anchor program ID
VAULT_PROGRAM_ID=JBagp4qXz26XMHce1tXMpEwgVKPBpRGj7ejvsJXaoQhH

# ── Jupiter Developer Platform (Bounty 1) ────────────────────────
# Single API key from developers.jup.ag for ALL Jupiter APIs
# (Prediction, Price, Tokens, Trigger, Lend)
JUPITER_API_KEY=your-key-from-developers.jup.ag
NEXT_PUBLIC_JUPITER_API_KEY=your-key-from-developers.jup.ag

# ── Dune SIM (Bounty 2) ─────────────────────────────────────────
# API key from sim.dune.com
DUNE_SIM_API_KEY=your-key-from-sim.dune.com
NEXT_PUBLIC_DUNE_SIM_API_KEY=your-key-from-sim.dune.com

# ── RPC Fast (Bounty 3) ─────────────────────────────────────────
# Optional: Yellowstone gRPC endpoint for real-time streaming
RPC_FAST_GRPC_URL=your-grpc-endpoint
