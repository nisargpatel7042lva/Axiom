# Copy to `.env.local` for local development. Never commit real secrets.

# --- RPC Fast (required) — sole Solana JSON-RPC provider for Flowr ---
# Create a project at https://rpcfast.com (or your RPC Fast dashboard) and paste the HTTPS RPC URL.
NEXT_PUBLIC_SOLANA_RPC_URL=https://YOUR_RPCFAST_ENDPOINT

# --- Helius (optional API key) — DAS / parsed transaction / webhook APIs ---
# RPC calls still go through RPC Fast; use Helius only for DAS and enhanced REST per architecture.
# Dashboard: https://dev.helius.xyz/
HELIUS_API_KEY=

# --- KIRAPAY — cross-chain deposits (ETH/BNB → Solana USDC) ---
# Obtain API key and base URL from your KIRAPAY merchant / developer console.
KIRAPAY_API_KEY=
# Override default from `constants/API_BASE_URLS.KIRAPAY` if you use a custom region.
KIRAPAY_API_BASE_URL=

# --- Dodo Payments — $9/mo subscription + treasury / payouts ---
# Keys from Dodo Payments dashboard (REST + webhook signing secret).
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# --- Jupiter (optional) — pro / higher rate limits if offered for your key ---
JUPITER_API_KEY=

# --- Colosseum Copilot (optional) — side-by-side research in /dashboard/research ---
# Generate a PAT at https://arena.colosseum.org/copilot — never commit real tokens.
COLOSSEUM_COPILOT_API_BASE="https://copilot.colosseum.com/api/v1"
COLOSSEUM_COPILOT_PAT="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..-bZqmGYF6E_9Is_DcKXQUfZ9acTDPaWQlb4S8j8_tvo"