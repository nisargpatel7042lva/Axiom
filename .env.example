# ═══════════════════════════════════════════════════════════════════
# Spectra Vaults — Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# SECURITY
# - Copy this file to `.env.local` (repo root) and `engine/.env` (engine).
# - Never commit real keys. Anything `NEXT_PUBLIC_*` is exposed in the browser.
# - See SECURITY-SECRETS.md in the repo root.
#
# ═══════════════════════════════════════════════════════════════════

# Solana cluster: devnet | testnet | mainnet-beta (default devnet)
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Solana RPC — fallback if RPC_FAST_HTTP_URL is not set
# When RPC_FAST_HTTP_URL is present it takes priority over these.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: custom USDC / test USDC mint (required if your testnet mint differs)
# NEXT_PUBLIC_USDC_MINT=

# Vault authority keypair (file must NOT be committed — keep outside repo or gitignored name)
WALLET_KEYPAIR_PATH=~/.config/solana/id.json
VAULT_AUTHORITY_KEYPAIR_PATH=./keypair.json

# USDC mint (devnet test token)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Deployed Anchor program ID
VAULT_PROGRAM_ID=JBagp4qXz26XMHce1tXMpEwgVKPBpRGj7ejvsJXaoQhH

# ── Jupiter Developer Platform (Bounty 1) ────────────────────────
# Single API key from developers.jup.ag for ALL Jupiter APIs
# (Prediction, Price, Tokens, Trigger, Lend)
# Server-only when possible (not bundled to the browser)
JUPITER_API_KEY=your-key-from-developers.jup.ag
# Optional safety switch for limit-order path (Trigger API).
# Recommended false when Trigger API error rate is elevated.
# JUPITER_TRIGGER_ENABLED=false
# Optional: only if you accept the key being visible in every user's browser (dev/demo)
NEXT_PUBLIC_JUPITER_API_KEY=

# ── Dune SIM (Bounty 2) ─────────────────────────────────────────
# API key from sim.dune.com — prefer server-only; avoid NEXT_PUBLIC in production
DUNE_SIM_API_KEY=your-key-from-sim.dune.com
NEXT_PUBLIC_DUNE_SIM_API_KEY=
# Shared secret for the Dune SIM webhook receiver at POST /api/webhooks/dune-sim
# Set this to the same value configured in the Dune SIM dashboard (Subscriptions → Webhooks)
DUNE_SIM_WEBHOOK_SECRET=

# ── RPC Fast (Bounty 3) ───────────────────────────────────────────
# Get endpoints from your RPC Fast dashboard.
# NEXT_PUBLIC_RPC_FAST_HTTP_URL — browser-safe alias; used by wallet provider,
#   latency hook, and all client components. REQUIRED for frontend to hit RPC Fast.
# RPC_FAST_HTTP_URL             — server-only (engine + API routes). Can be same URL.
# gRPC (Yellowstone) endpoint enables real-time account-change streaming in the engine.
NEXT_PUBLIC_RPC_FAST_HTTP_URL=https://your-devnet-endpoint.rpcfast.com
RPC_FAST_HTTP_URL=https://your-devnet-endpoint.rpcfast.com
RPC_FAST_GRPC_URL=your-devnet-endpoint.rpcfast.com:443

# ── PostHog Analytics (tester telemetry) ─────────────────────────────────────
# Project API key from PostHog project settings (safe for client-side use).
NEXT_PUBLIC_POSTHOG_KEY=
# Alias used in some dashboards/setups; either key works in this app.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Optional explicit toggle. Defaults to enabled when key is present.
# NEXT_PUBLIC_POSTHOG_ENABLED=true
# Optional region host (US default below). Example EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Same-origin proxy path used by default to reduce blocked requests.
NEXT_PUBLIC_POSTHOG_PROXY_PATH=/ingest

# ── Supabase (portfolio metrics, agent identity, activity log) ───────────────
# Create a project at supabase.com, run docs/supabase-migrations/ in SQL editor
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ── Engine AI — market scoring (Anthropic Claude) ─────────────────────────────
# Get key at console.anthropic.com — used only by the engine, never sent to browser
AI_API_KEY=your-anthropic-api-key
# AI_PROVIDER=anthropic          # anthropic | openai (default: anthropic)
# AI_MODEL=claude-haiku-4-5-20251001
# AI_MAX_CALLS_PER_HOUR=50
# AI_ENABLED=true

# ── App URL (used by engine to call Next.js API routes) ───────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
